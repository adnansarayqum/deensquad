{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "sh -c 'node scripts/migrate.mjs && exec node_modules/.bin/next start'",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "drainingSeconds": 60,
    "multiRegionConfig": {
      "sfo": {
        "numReplicas": 1
      }
    }
  }
}
