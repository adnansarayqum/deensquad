# Copy to .env.local for local overrides. Never commit real values.
# Nothing is required for local development: `npm run dev` uses an in-process Postgres in .data/db
# with a sample club, and writes emails to .data/outbox.jsonl.

# Database. On Railway this is ${{Postgres.DATABASE_URL}}.
# DATABASE_URL=postgres://user:password@host:5432/db
# DATABASE_URL=pglite://memory        # throwaway in-memory database
# DEV_SEED=0                          # start the local database empty instead of with the sample club

# The app's public address, used in emailed links. Railway's own domain is used if this is unset.
# APP_URL=https://app.thedeensquadfootballacademy.co.uk

# People made admins on first sign-in (comma-separated).
# ADMIN_EMAILS=you@example.com

# Email through Resend (https://resend.com). EMAIL_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Deen Squad <app@thedeensquadfootballacademy.co.uk>

# Links shown in the app.
# TEAMFEEPAY_URL=
# PRIVACY_URL=

# Club shop. Parents pay by card (SumUp) and/or bank transfer; at least one must be set.
# SUMUP_API_KEY=
# SUMUP_MERCHANT_CODE=
# BANK_ACCOUNT_NAME=
# BANK_SORT_CODE=
# BANK_ACCOUNT_NUMBER=
# New-order emails go to every admin, or to these addresses (comma-separated).
# SHOP_ORDERS_EMAIL=

# Chase ladder. Notifications need a VAPID key pair (npx web-push generate-vapid-keys).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-app-address
# The hourly job (Railway cron function "chase-ladder") calls POST /api/cron/chase with this secret.
# CRON_SECRET=
# Text reminders after 48 hours, through Twilio. TWILIO_FROM is a +44 number or a sender name.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# AI writing help for staff ("Tidy up with AI"). Leave unset to show dictation only.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
